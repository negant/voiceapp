# Voice App API — copy to server/.env
#
# Local dev:
#   HOST=0.0.0.0
#   NODE_ENV=development
#   → http://localhost:8787 + pliki server/logs/api-*.log
#
# Production VPS (api.ukrywane.pl, Caddy :443 → 127.0.0.1:8787):
#   HOST=127.0.0.1
#   NODE_ENV=production
#   API_TOKEN — openssl rand -hex 32 (ten sam w app: BACKEND_API_TOKEN)
#   POSTGRES_PASSWORD — silne hasło; DATABASE_URL musi mieć to samo user/hasło

PORT=8787
HOST=0.0.0.0
NODE_ENV=development

# Shared secret — app: Authorization: Bearer <BACKEND_API_TOKEN>
API_TOKEN=dev-voiceapp-api-token-change-me

# Postgres (docker compose — user/hasło muszą zgadzać się z DATABASE_URL)
POSTGRES_USER=voiceapp
POSTGRES_PASSWORD=voiceapp
POSTGRES_DB=voiceapp
POSTGRES_PORT=5432
DATABASE_URL=postgres://voiceapp:voiceapp@127.0.0.1:5432/voiceapp

# Economy defaults (keep in sync with app .env where applicable)
STARTING_FREE_CREDITS=10
FREE_CREDITS_VALIDITY_MONTHS=3
PREMIUM_CREDITS=100
PREMIUM_GRATIS_CREDITS=25
FREE_INSTALLS_WITH_TEST_CREDITS=30
CREDITS_PER_STARTED_MINUTE=1
