# Voice App API — copy to server/.env
PORT=8787
HOST=0.0.0.0
NODE_ENV=development

# Shared secret — app sends Authorization: Bearer <token>
API_TOKEN=dev-voiceapp-api-token-change-me

# Postgres (matches docker-compose defaults)
DATABASE_URL=postgres://voiceapp:voiceapp@127.0.0.1:5432/voiceapp
POSTGRES_USER=voiceapp
POSTGRES_PASSWORD=voiceapp
POSTGRES_DB=voiceapp
POSTGRES_PORT=5432

# Domain defaults (keep in sync with app .env / credits config)
STARTING_FREE_CREDITS=10
FREE_CREDITS_VALIDITY_MONTHS=3
PREMIUM_CREDITS=100
PREMIUM_GRATIS_CREDITS=25
FREE_INSTALLS_WITH_TEST_CREDITS=30000
CREDITS_PER_STARTED_MINUTE=1
