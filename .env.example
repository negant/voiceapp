# Voice App — zmienne środowiskowe
# Skopiuj do .env: cp .env.example .env

# Środowisko: development | staging | production
APP_ENV=development

# Tryb debug (logi w konsoli)
DEBUG_MODE=true

# Safety ceiling for absurdly large imports (MB) — primary limit is clip duration, not size
MAX_UPLOAD_SIZE_MB=500

# Obsługiwane formaty wejściowe (rozdzielone przecinkami)
SUPPORTED_AUDIO_FORMATS=mp3,wav,m4a,aac

# Liczba wątków / workerów przetwarzania (docelowo)
PROCESSING_THREADS=2

# Włącz podgląd audio przed eksportem
ENABLE_AUDIO_PREVIEW=true

# Odszumianie przy konwersji Basic/Advanced (nie przy imporcie/nagraniu)
ENABLE_SOURCE_DENOISE=true
# Siła odszumiania przy konwersji (0–1; wyższe = mocniejsze tłumienie szumu)
SOURCE_DENOISE_STRENGTH=0.58

# Nazwa wyświetlana aplikacji (opcjonalnie, nadpisuje app.json w przyszłości)
APP_DISPLAY_NAME=Voice App

# WaveSpeed Chatterbox Speech-to-Speech (AI Effects)
# https://wavespeed.ai/models/chatterbox/speech-to-speech
# Nigdy nie commituj prawdziwego klucza.
WAVESPEED_API_KEY=
ENABLE_WAVESPEED_STS=true

# Credits charged per started minute of AI (1 credit = 1 started minute)
CREDITS_PER_STARTED_MINUTE=1

# Free-plan welcome credits granted once on first install (~$0.20 API at $0.02/min)
STARTING_CREDITS=10

# Premium economy — price, app retail rate, and pack size (easy to tune)
# WaveSpeed API cost stays $0.02/min in code (WAVESPEED_USD_PER_STARTED_MINUTE)
PREMIUM_PRICE_USD=4.99
APP_USD_PER_STARTED_MINUTE=0.05
PREMIUM_CREDITS=100
PREMIUM_GRATIS_CREDITS=25

# Max clip duration (seconds) by account plan — free 1 min (1 AI credit), premium 10 min
MAX_AUDIO_DURATION_FREE_SEC=60
MAX_AUDIO_DURATION_PREMIUM_SEC=600

# Backend kredytów (server/ — patrz .aiassistant/rules/credits-backend.md)
# Puste CREDITS_API_BASE_URL → tylko lokalne kredyty (offline fallback).
# CREDITS_API_TOKEN musi być identyczny z API_TOKEN w server/.env (openssl rand -hex 32).
#
# Production (HTTPS, iOS + Android):
CREDITS_API_BASE_URL=https://api.ukrywane.pl
CREDITS_API_TOKEN=change-me-same-as-server-API_TOKEN
#
# Local dev (cd server && npm run dev):
# CREDITS_API_BASE_URL=http://192.168.0.30:8787
# CREDITS_API_TOKEN=dev-voiceapp-api-token-change-me
# Emulator Android: http://10.0.2.2:8787
# iOS Simulator: http://localhost:8787
# Po zmianie .env: npm start -- --reset-cache
