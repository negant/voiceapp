{
  "name": "VoiceApp",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android --port 8088",
    "ios": "react-native run-ios --port 8088 --simulator \"iPhone 17\"",
    "lint": "eslint .",
    "start": "react-native start --port 8088",
    "start:reset": "react-native start --reset-cache --port 8088",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "generate:icons": "node scripts/generate-app-icons.mjs",
    "generate:store-assets": "node scripts/generate-store-assets.mjs",
    "android:keystore": "node scripts/generate-release-keystore.mjs",
    "android:bundle:release": "node scripts/check-release-keystore.mjs && cd android && ./gradlew bundleRelease",
    "i18n:schema": "node scripts/sync-i18n-schema.mjs",
    "postinstall": "patch-package",
    "api:install": "npm install --prefix server",
    "api:docker": "npm run docker:up --prefix server",
    "api:dev": "npm run dev --prefix server",
    "api:test": "npm test --prefix server",
    "api:health": "curl -fsS \"${BACKEND_API_BASE_URL:-https://api.ukrywane.pl}/health\""
  },
  "dependencies": {
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native-documents/picker": "^12.0.1",
    "@react-native/new-app-screen": "0.86.0",
    "@react-navigation/native": "^7.3.5",
    "@react-navigation/native-stack": "^7.17.7",
    "@soundtouchjs/core": "^2.0.4",
    "@soundtouchjs/interpolation-strategy-lanczos": "^2.0.4",
    "@soundtouchjs/interpolation-strategy-linear": "^2.0.4",
    "lucide-react-native": "^1.23.0",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-audio-api": "^0.13.1",
    "react-native-blob-util": "^0.24.10",
    "react-native-dotenv": "^3.4.11",
    "react-native-gesture-handler": "^2.32.0",
    "react-native-iap": "^15.5.4",
    "react-native-keychain": "^10.0.0",
    "react-native-nitro-modules": "^0.36.1",
    "react-native-reanimated": "^4.5.1",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.25.2",
    "react-native-sound-player": "^0.14.5",
    "react-native-sqlite-storage": "^6.0.1",
    "react-native-svg": "^15.15.5",
    "react-native-worklets": "^0.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.86.0",
    "@react-native/eslint-config": "0.86.0",
    "@react-native/jest-preset": "^0.86.0",
    "@react-native/metro-config": "0.86.0",
    "@react-native/typescript-config": "0.86.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "patch-package": "^8.0.1",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
